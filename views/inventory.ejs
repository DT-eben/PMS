<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PMS - Drug Inventory</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:'Inter',sans-serif;
}

body{
  display:flex;
  background:#f1f5f9;
  min-height:100vh;
  color:#0f172a;
}

/* SIDEBAR */
.sidebar{
  width:220px;
  background:#1e293b;
  color:white;
  padding:20px;
  flex-shrink:0;
}

.sidebar h2{
  margin-bottom:20px;
  font-size:18px;
  font-weight:600;
}

.sidebar a{
  display:block;
  color:white;
  text-decoration:none;
  padding:12px;
  border-radius:8px;
  margin-bottom:8px;
  font-size:14px;
  transition:0.2s;
}

.sidebar a:hover,
.sidebar .active{
  background:#3b82f6;
}

/* MAIN */
.main{
  flex:1;
  padding:30px;
  overflow-y:auto;
}

/* TOPBAR */
.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:28px;
}

.topbar h2{
  font-size:20px;
  font-weight:600;
  color:#0f172a;
}

.topbar span{
  font-size:14px;
  color:#64748b;
  font-weight:500;
}

/* FLASH */
.flash{
  padding:12px 18px;
  border-radius:10px;
  margin-bottom:20px;
  font-size:14px;
  font-weight:500;
  display:flex;
  align-items:center;
  gap:10px;
}

.flash-success{
  background:#dcfce7;
  color:#166534;
  border-left:4px solid #22c55e;
}

.flash-error{
  background:#fee2e2;
  color:#991b1b;
  border-left:4px solid #ef4444;
}

/* STATS */
.stats-row{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
  margin-bottom:28px;
}

.stat-card{
  background:white;
  border-radius:14px;
  padding:22px;
  box-shadow:0 2px 8px rgba(0,0,0,0.05);
  display:flex;
  align-items:center;
  gap:16px;
}

.stat-icon{
  width:48px;
  height:48px;
  border-radius:12px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:20px;
  flex-shrink:0;
}

.stat-icon.total{
  background:#dbeafe;
  color:#1d4ed8;
}

.stat-icon.low{
  background:#fef3c7;
  color:#92400e;
}

.stat-icon.out{
  background:#fee2e2;
  color:#991b1b;
}

.stat-icon.expiring{
  background:#ffedd5;
  color:#9a3412;
}

.stat-info p{
  font-size:12px;
  color:#94a3b8;
  font-weight:500;
  margin-bottom:3px;
}

.stat-info h3{
  font-size:24px;
  font-weight:700;
  color:#0f172a;
}

/* FILTER BAR */
.filter-bar{
  background:white;
  border-radius:14px;
  box-shadow:0 2px 8px rgba(0,0,0,0.05);
  padding:18px 22px;
  margin-bottom:24px;
  display:flex;
  align-items:flex-end;
  gap:14px;
  flex-wrap:wrap;
}

.filter-group{
  flex:1;
  min-width:160px;
}

.filter-group label{
  display:block;
  font-size:11px;
  font-weight:600;
  color:#64748b;
  text-transform:uppercase;
  letter-spacing:0.5px;
  margin-bottom:6px;
}

.filter-group input,
.filter-group select{
  width:100%;
  padding:10px 12px;
  border:1.5px solid #e2e8f0;
  border-radius:8px;
  font-size:14px;
  color:#0f172a;
  outline:none;
  transition:0.2s;
  font-family:'Inter',sans-serif;
  background:white;
}

.filter-group input:focus,
.filter-group select:focus{
  border-color:#3b82f6;
  box-shadow:0 0 0 3px rgba(59,130,246,0.1);
}

/* BADGES */
.badge{
  padding:5px 11px;
  border-radius:20px;
  font-size:11px;
  font-weight:600;
  white-space:nowrap;
}

.badge-instock{
  background:#dcfce7;
  color:#166534;
}

.badge-low{
  background:#fef3c7;
  color:#92400e;
}

.badge-out{
  background:#fee2e2;
  color:#991b1b;
}

.badge-discontinued{
  background:#f1f5f9;
  color:#64748b;
}

/* BUTTONS */
.btn-action{
  padding:8px 14px;
  border-radius:8px;
  font-size:13px;
  font-weight:500;
  cursor:pointer;
  transition:0.2s;
  border:none;
  display:inline-flex;
  align-items:center;
  gap:7px;
  text-decoration:none;
}

.btn-primary{
  background:#1e293b;
  color:white;
}

.btn-primary:hover{
  background:#334155;
}

.btn-view{
  background:white;
  color:#475569;
  border:1.5px solid #e2e8f0;
}

.btn-view:hover{
  background:#f8fafc;
  color:#1e293b;
}

.btn-danger{
  background:white;
  color:#991b1b;
  border:1.5px solid #fecaca;
}

.btn-danger:hover{
  background:#fee2e2;
}

.btn-block{
  width:100%;
  justify-content:center;
}

/* EMPTY */
.empty-state{
  padding:70px 20px;
  text-align:center;
  color:#94a3b8;
  background:white;
  border-radius:14px;
  box-shadow:0 2px 8px rgba(0,0,0,0.05);
}

.empty-state i{
  font-size:34px;
  margin-bottom:12px;
  display:block;
}

.empty-state p{
  font-size:14px;
}

/* DRUG CARD GRID */
.drug-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(300px, 1fr));
  gap:20px;
}

.drug-card{
  background:white;
  border-radius:14px;
  box-shadow:0 2px 8px rgba(0,0,0,0.05);
  padding:20px;
  display:flex;
  flex-direction:column;
  gap:14px;
}

.drug-card.discontinued{
  opacity:0.6;
}

.drug-card-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:10px;
}

.drug-card-head h4{
  font-size:16px;
  font-weight:700;
  color:#0f172a;
}

.drug-strength{
  font-size:12px;
  font-weight:500;
  color:#64748b;
}

.drug-generic{
  font-size:12px;
  color:#94a3b8;
  margin-top:2px;
}

.drug-info{
  border-top:1px solid #f1f5f9;
  border-bottom:1px solid #f1f5f9;
  padding:12px 0;
  display:flex;
  flex-direction:column;
  gap:8px;
}

.drug-info-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  font-size:13px;
}

.drug-info-row span{
  color:#94a3b8;
}

.drug-info-row strong{
  color:#1e293b;
  font-weight:600;
  text-align:right;
}

.drug-info-row strong.expired{
  color:#991b1b;
}

.drug-info-row strong.expiring{
  color:#9a3412;
}

.drug-price-row{
  display:flex;
  gap:10px;
}

.drug-price-box{
  flex:1;
  background:#f8fafc;
  border:1px solid #e2e8f0;
  border-radius:10px;
  padding:10px 12px;
  text-align:center;
}

.drug-price-box p{
  font-size:10px;
  color:#94a3b8;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:0.5px;
  margin-bottom:4px;
}

.drug-price-box h5{
  font-size:15px;
  font-weight:700;
  color:#0f172a;
}

.drug-card-actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}

.drug-card-actions form{
  display:contents;
}

/* MODAL */
.modal-overlay{
  position:fixed;
  inset:0;
  background:rgba(15,23,42,0.55);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:1000;
  padding:20px;
}

.modal-overlay.open{
  display:flex;
}

.modal{
  background:white;
  border-radius:16px;
  width:100%;
  max-width:560px;
  overflow:hidden;
  box-shadow:0 20px 60px rgba(0,0,0,0.2);
}

.modal-header{
  background:#1e293b;
  color:white;
  padding:20px 24px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.modal-header h3{
  font-size:15px;
  font-weight:600;
  display:flex;
  align-items:center;
  gap:8px;
}

.modal-close{
  background:transparent;
  border:none;
  color:#cbd5e1;
  font-size:22px;
  cursor:pointer;
  line-height:1;
  transition:0.2s;
}

.modal-close:hover{
  color:white;
}

.modal-body{
  padding:24px;
  max-height:70vh;
  overflow-y:auto;
}

.modal-footer{
  padding:18px 24px;
  border-top:1px solid #f1f5f9;
  display:flex;
  justify-content:flex-end;
  gap:12px;
}

/* MODAL FORM */
.m-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
}

.m-group{
  margin-bottom:18px;
}

.m-group label{
  display:block;
  font-size:11px;
  font-weight:600;
  color:#64748b;
  text-transform:uppercase;
  letter-spacing:0.5px;
  margin-bottom:6px;
}

.m-group input,
.m-group select,
.m-group textarea{
  width:100%;
  padding:11px 13px;
  border:1.5px solid #e2e8f0;
  border-radius:8px;
  font-size:14px;
  color:#0f172a;
  outline:none;
  transition:0.2s;
  font-family:'Inter',sans-serif;
  background:white;
}

.m-group input:focus,
.m-group select:focus,
.m-group textarea:focus{
  border-color:#3b82f6;
  box-shadow:0 0 0 3px rgba(59,130,246,0.1);
}

.m-group textarea{
  resize:vertical;
  min-height:70px;
}

.m-info-box{
  background:#f8fafc;
  border-radius:10px;
  padding:15px;
  border:1px solid #e2e8f0;
  margin-bottom:20px;
  font-size:13px;
  color:#475569;
  line-height:1.8;
}

.m-info-box strong{
  color:#0f172a;
}

/* MODAL BUTTONS */
.btn-submit{
  padding:10px 22px;
  background:#1e293b;
  color:white;
  border:none;
  border-radius:8px;
  font-size:14px;
  font-weight:600;
  cursor:pointer;
  transition:0.2s;
  display:inline-flex;
  align-items:center;
  gap:7px;
}

.btn-submit:hover{
  background:#334155;
}

.btn-cancel{
  padding:10px 18px;
  background:white;
  color:#64748b;
  border:1.5px solid #e2e8f0;
  border-radius:8px;
  font-size:14px;
  font-weight:500;
  cursor:pointer;
  transition:0.2s;
}

.btn-cancel:hover{
  background:#f8fafc;
  color:#1e293b;
}

/* HISTORY LIST */
.history-item{
  background:#f8fafc;
  border:1px solid #e2e8f0;
  border-radius:10px;
  padding:14px 16px;
  margin-bottom:10px;
  font-size:13px;
  color:#1e293b;
}

.history-item .history-date{
  font-size:11px;
  color:#94a3b8;
  margin-bottom:6px;
}

/* RESPONSIVE */
@media(max-width:1000px){
  .stats-row{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:768px){

  body{
    flex-direction:column;
  }

  .sidebar{
    width:100%;
  }

  .main{
    padding:20px;
  }

  .topbar{
    flex-direction:column;
    align-items:flex-start;
    gap:10px;
  }

  .drug-grid{
    grid-template-columns:1fr;
  }

  .m-row{
    grid-template-columns:1fr;
  }

  .modal-footer{flex-direction:column-reverse;gap:8px;}
  .modal-footer button,.modal-footer .btn-submit,.modal-footer .btn-cancel{width:100%;}
}
</style>
</head>
<body>

<!-- SIDEBAR -->
<div class="sidebar">
  <h2>PMS</h2>
  <a href="/dashboard">Dashboard</a>

  <% if (role === 'nurse' || role === 'doctor' || role === 'admin') { %>
    <a href="/records">Patients</a>
  <% } %>

  <% if (role === 'nurse' || role === 'doctor' || role === 'admin') { %>
    <a href="/visits">Visits</a>
  <% } %>

  <% if (role === 'admin') { %>
    <a href="/doctors">Doctors</a>
  <% } %>

  <% if (role === 'doctor') { %>
    <a href="/queue">Queue</a>
  <% } %>

  <% if (role === 'admin') { %>
    <a href="/nurses">Nurses</a>
  <% } %>

  <% if (role === 'nurse' || role === 'doctor' || role === 'admin') { %>
    <a href="/admitted">Admitted</a>
  <% } %>

  <% if (role === 'lab') { %>
    <a href="/lab">Labs</a>
  <% } %>


  <% if (role === 'pharmacist') { %>
    <a href="/pharmacy"> Pharmacy</a>
  <% } %>

    
  <% if (role === 'pharmacist') { %>
    <a href="/inventory" class="active"> Inventory</a>
  <% } %>

  <a href="/settings" >Settings</a>
</div>

<!-- MAIN -->
<div class="main">

  <div class="topbar">
    <h2>Drug Inventory</h2>
    <span><%= name %></span>
  </div>

  <!-- FLASH -->
  <% if (success && success.length > 0) { %>
    <div class="flash flash-success"><i class="bi bi-check-circle"></i> <%= success %></div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="flash flash-error"><i class="bi bi-exclamation-circle"></i> <%= error %></div>
  <% } %>

  <!-- STATS -->
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-icon total"><i class="bi bi-capsule"></i></div>
      <div class="stat-info">
        <p>Total Drugs</p>
        <h3><%= totalDrugs %></h3>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon low"><i class="bi bi-exclamation-triangle"></i></div>
      <div class="stat-info">
        <p>Low Stock</p>
        <h3><%= lowStock %></h3>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon out"><i class="bi bi-x-circle"></i></div>
      <div class="stat-info">
        <p>Out of Stock</p>
        <h3><%= outOfStock %></h3>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon expiring"><i class="bi bi-hourglass-split"></i></div>
      <div class="stat-info">
        <p>Expiring Soon (30d)</p>
        <h3><%= expiringSoon %></h3>
      </div>
    </div>
  </div>

  <!-- FILTER BAR -->
  <form class="filter-bar" method="GET" action="/inventory">
    <div class="filter-group">
      <label>Search</label>
      <input type="text" name="search" placeholder="Drug name, generic name, batch..." value="<%= search %>">
    </div>
    <div class="filter-group">
      <label>Category</label>
      <select name="category">
        <option value="">All Categories</option>
        <% categories.forEach(c => { %>
          <option value="<%= c %>" <%= category === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div class="filter-group">
      <label>Stock Status</label>
      <select name="stockStatus">
        <option value="">All</option>
        <option value="low"      <%= stockStatus === 'low'      ? 'selected' : '' %>>Low Stock</option>
        <option value="out"      <%= stockStatus === 'out'      ? 'selected' : '' %>>Out of Stock</option>
        <option value="expiring" <%= stockStatus === 'expiring' ? 'selected' : '' %>>Expiring Soon</option>
        <option value="expired"  <%= stockStatus === 'expired'  ? 'selected' : '' %>>Expired</option>
      </select>
    </div>
    <button type="submit" class="btn-action btn-view"><i class="bi bi-search"></i> Filter</button>
    <button type="button" class="btn-action btn-primary" onclick="openAdd()"><i class="bi bi-plus-lg"></i> Add New Drug</button>
  </form>

  <!-- DRUG GRID -->
  <% if (drugs.length === 0) { %>
    <div class="empty-state">
      <i class="bi bi-capsule"></i>
      <p>No drugs match your filters</p>
    </div>
  <% } else { %>
  <div class="drug-grid">
    <% drugs.forEach(drug => { %>
      <%
        const now = new Date();
        const soon = new Date(now.getTime() + 30*24*60*60*1000);
        let stockBadge = { cls: 'badge-instock', label: 'In Stock' };
        if (drug.quantityInStock <= 0) {
          stockBadge = { cls: 'badge-out', label: 'Out of Stock' };
        } else if (drug.quantityInStock <= drug.reorderLevel) {
          stockBadge = { cls: 'badge-low', label: 'Low Stock' };
        }
        let expiryClass = '';
        let expiryLabel = drug.expiryDate ? new Date(drug.expiryDate).toLocaleDateString('en-GB') : '—';
        if (drug.expiryDate && new Date(drug.expiryDate) < now) {
          expiryClass = 'expired';
          expiryLabel += ' (Expired)';
        } else if (drug.expiryDate && new Date(drug.expiryDate) <= soon) {
          expiryClass = 'expiring';
          expiryLabel += ' (Soon)';
        }
      %>
      <div class="drug-card <%= drug.status === 'discontinued' ? 'discontinued' : '' %>">
        <div class="drug-card-head">
          <div>
            <h4><%= drug.name %> <span class="drug-strength"><%= drug.strength || '' %></span></h4>
            <div class="drug-generic"><%= drug.genericName || drug.category || '' %></div>
          </div>
          <% if (drug.status === 'discontinued') { %>
            <span class="badge badge-discontinued">Discontinued</span>
          <% } else { %>
            <span class="badge <%= stockBadge.cls %>"><%= stockBadge.label %></span>
          <% } %>
        </div>

        <div class="drug-info">
          <div class="drug-info-row"><span>Category</span><strong><%= drug.category || '—' %></strong></div>
          <div class="drug-info-row"><span>Form</span><strong><%= drug.form || '—' %></strong></div>
          <div class="drug-info-row"><span>Batch No.</span><strong><%= drug.batchNumber || '—' %></strong></div>
          <div class="drug-info-row"><span>Serial No.</span><strong><%= drug.serialNumber || '—' %></strong></div>
          <div class="drug-info-row"><span>Expiry</span><strong class="<%= expiryClass %>"><%= expiryLabel %></strong></div>
          <div class="drug-info-row"><span>In Stock</span><strong><%= drug.quantityInStock %> <%= drug.unit %>(s)</strong></div>
        </div>

        <div class="drug-price-row">
          <div class="drug-price-box">
            <p>Cost Price</p>
            <h5>GHS <%= drug.costPrice.toFixed(2) %></h5>
          </div>
          <div class="drug-price-box">
            <p>Selling Price</p>
            <h5>GHS <%= drug.sellingPrice.toFixed(2) %></h5>
          </div>
        </div>

        <div class="drug-card-actions">
          <button class="btn-action btn-primary btn-block"
            onclick='openRestock("<%= drug._id %>", "<%= drug.name %>", <%= drug.costPrice %>, <%= drug.sellingPrice %>, "<%= drug.batchNumber || "" %>")'>
            <i class="bi bi-box-seam"></i> Restock
          </button>
          <button class="btn-action btn-view btn-block"
            data-name="<%= drug.name %>"
            data-history='<%- JSON.stringify(drug.priceHistory || []).replace(/'/g, "&#39;") %>'
            onclick="openHistoryFromBtn(this)">
            <i class="bi bi-clock-history"></i> History
          </button>
          <button class="btn-action btn-view btn-block"
            onclick='openEdit("<%= drug._id %>", "<%= drug.name %>", "<%= drug.genericName || "" %>", "<%= drug.category || "" %>", "<%= drug.form || "" %>", "<%= drug.strength || "" %>", "<%= drug.unit || "" %>", "<%= drug.manufacturer || "" %>", "<%= drug.serialNumber || "" %>", <%= drug.reorderLevel %>)'>
            <i class="bi bi-pencil"></i> Edit
          </button>
          <form method="POST" action="/inventory/<%= drug._id %>/delete" onsubmit="return confirm('Remove <%= drug.name %> from inventory permanently?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn-action btn-danger btn-block">
              <i class="bi bi-trash"></i> Delete
            </button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
  <% } %>

</div>

<!-- ADD DRUG MODAL -->
<div class="modal-overlay" id="addModal">
  <div class="modal">
    <div class="modal-header">
      <h3><i class="bi bi-plus-circle"></i> Add New Drug</h3>
      <button class="modal-close" onclick="closeModal('addModal')">✕</button>
    </div>
    <form method="POST" action="/inventory/add">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-body">
        <div class="m-row">
          <div class="m-group">
            <label>Drug Name *</label>
            <input type="text" name="name" placeholder="e.g. Panadol" required>
          </div>
          <div class="m-group">
            <label>Generic Name</label>
            <input type="text" name="genericName" placeholder="e.g. Paracetamol">
          </div>
        </div>
        <div class="m-row">
          <div class="m-group">
            <label>Category *</label>
            <input type="text" name="category" placeholder="e.g. Analgesic" required>
          </div>
          <div class="m-group">
            <label>Form</label>
            <select name="form">
              <option value="Tablet">Tablet</option>
              <option value="Capsule">Capsule</option>
              <option value="Syrup">Syrup</option>
              <option value="Injection">Injection</option>
              <option value="Cream">Cream</option>
              <option value="Ointment">Ointment</option>
              <option value="Drops">Drops</option>
              <option value="Inhaler">Inhaler</option>
              <option value="Suppository">Suppository</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>
        <div class="m-row">
          <div class="m-group">
            <label>Strength</label>
            <input type="text" name="strength" placeholder="e.g. 500mg">
          </div>
          <div class="m-group">
            <label>Unit</label>
            <input type="text" name="unit" placeholder="e.g. tablet, bottle, vial">
          </div>
        </div>
        <div class="m-group">
          <label>Manufacturer</label>
          <input type="text" name="manufacturer" placeholder="e.g. GSK">
        </div>
        <div class="m-row">
          <div class="m-group">
            <label>Batch Number</label>
            <input type="text" name="batchNumber" placeholder="e.g. B20260601">
          </div>
          <div class="m-group">
            <label>Serial No. / Barcode</label>
            <input type="text" name="serialNumber" placeholder="optional">
          </div>
        </div>
        <div class="m-row">
          <div class="m-group">
            <label>Quantity In Stock</label>
            <input type="number" name="quantityInStock" min="0" step="1" placeholder="e.g. 100">
          </div>
          <div class="m-group">
            <label>Reorder Level</label>
            <input type="number" name="reorderLevel" min="0" step="1" placeholder="e.g. 10" value="10">
          </div>
        </div>
        <div class="m-row">
          <div class="m-group">
            <label>Cost Price (GHS)</label>
            <input type="number" name="costPrice" min="0" step="0.01" placeholder="e.g. 1.50">
          </div>
          <div class="m-group">
            <label>Selling Price (GHS)</label>
            <input type="number" name="sellingPrice" min="0" step="0.01" placeholder="e.g. 3.00">
          </div>
        </div>
        <div class="m-group">
          <label>Expiry Date</label>
          <input type="date" name="expiryDate">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-cancel" onclick="closeModal('addModal')">Cancel</button>
        <button type="submit" class="btn-submit"><i class="bi bi-check-lg"></i> Add Drug</button>
      </div>
    </form>
  </div>
</div>

<!-- RESTOCK MODAL -->
<div class="modal-overlay" id="restockModal">
  <div class="modal">
    <div class="modal-header">
      <h3><i class="bi bi-box-seam"></i> Restock Drug</h3>
      <button class="modal-close" onclick="closeModal('restockModal')">✕</button>
    </div>
    <form method="POST" id="restockForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-body">
        <div class="m-info-box">
          <div><strong id="restock-name"></strong></div>
          <div style="margin-top:4px;">Current cost: GHS <strong id="restock-current-cost"></strong> · Current selling: GHS <strong id="restock-current-selling"></strong></div>
        </div>
        <div class="m-group">
          <label>Quantity Added *</label>
          <input type="number" name="quantityAdded" min="1" step="1" placeholder="e.g. 200" required>
        </div>
        <div class="m-row">
          <div class="m-group">
            <label>New Cost Price (GHS)</label>
            <input type="number" name="costPrice" id="restock-cost-input" min="0" step="0.01" placeholder="leave blank to keep current">
          </div>
          <div class="m-group">
            <label>New Selling Price (GHS)</label>
            <input type="number" name="sellingPrice" id="restock-selling-input" min="0" step="0.01" placeholder="leave blank to keep current">
          </div>
        </div>
        <div class="m-row">
          <div class="m-group">
            <label>New Batch Number</label>
            <input type="text" name="batchNumber" id="restock-batch-input" placeholder="leave blank to keep current">
          </div>
          <div class="m-group">
            <label>New Expiry Date</label>
            <input type="date" name="expiryDate">
          </div>
        </div>
        <div class="m-group">
          <label>Note (optional)</label>
          <textarea name="note" placeholder="e.g. Price increased due to supplier change"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-cancel" onclick="closeModal('restockModal')">Cancel</button>
        <button type="submit" class="btn-submit"><i class="bi bi-check-lg"></i> Save Restock</button>
      </div>
    </form>
  </div>
</div>

<!-- EDIT MODAL -->
<div class="modal-overlay" id="editModal">
  <div class="modal">
    <div class="modal-header">
      <h3><i class="bi bi-pencil"></i> Edit Drug Details</h3>
      <button class="modal-close" onclick="closeModal('editModal')">✕</button>
    </div>
    <form method="POST" id="editForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-body">
        <div class="m-row">
          <div class="m-group">
            <label>Drug Name *</label>
            <input type="text" name="name" id="edit-name" required>
          </div>
          <div class="m-group">
            <label>Generic Name</label>
            <input type="text" name="genericName" id="edit-genericName">
          </div>
        </div>
        <div class="m-row">
          <div class="m-group">
            <label>Category *</label>
            <input type="text" name="category" id="edit-category" required>
          </div>
          <div class="m-group">
            <label>Form</label>
            <select name="form" id="edit-form">
              <option value="Tablet">Tablet</option>
              <option value="Capsule">Capsule</option>
              <option value="Syrup">Syrup</option>
              <option value="Injection">Injection</option>
              <option value="Cream">Cream</option>
              <option value="Ointment">Ointment</option>
              <option value="Drops">Drops</option>
              <option value="Inhaler">Inhaler</option>
              <option value="Suppository">Suppository</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>
        <div class="m-row">
          <div class="m-group">
            <label>Strength</label>
            <input type="text" name="strength" id="edit-strength">
          </div>
          <div class="m-group">
            <label>Unit</label>
            <input type="text" name="unit" id="edit-unit">
          </div>
        </div>
        <div class="m-group">
          <label>Manufacturer</label>
          <input type="text" name="manufacturer" id="edit-manufacturer">
        </div>
        <div class="m-row">
          <div class="m-group">
            <label>Serial No. / Barcode</label>
            <input type="text" name="serialNumber" id="edit-serialNumber">
          </div>
          <div class="m-group">
            <label>Reorder Level</label>
            <input type="number" name="reorderLevel" id="edit-reorderLevel" min="0" step="1">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-cancel" onclick="closeModal('editModal')">Cancel</button>
        <button type="submit" class="btn-submit"><i class="bi bi-check-lg"></i> Save Changes</button>
      </div>
    </form>
  </div>
</div>

<!-- HISTORY MODAL -->
<div class="modal-overlay" id="historyModal">
  <div class="modal">
    <div class="modal-header">
      <h3><i class="bi bi-clock-history"></i> Price &amp; Batch History</h3>
      <button class="modal-close" onclick="closeModal('historyModal')">✕</button>
    </div>
    <div class="modal-body">
      <div class="m-info-box">
        <strong id="history-name"></strong>
      </div>
      <div id="history-list"></div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn-cancel" onclick="closeModal('historyModal')">Close</button>
    </div>
  </div>
</div>

<script>
function openAdd(){
  document.getElementById('addModal').classList.add('open');
}

function closeModal(id){
  document.getElementById(id).classList.remove('open');
}

// RESTOCK
function openRestock(id, name, costPrice, sellingPrice, batchNumber){
  document.getElementById('restockForm').action = '/inventory/' + id + '/restock';
  document.getElementById('restock-name').textContent = name;
  document.getElementById('restock-current-cost').textContent = Number(costPrice).toFixed(2);
  document.getElementById('restock-current-selling').textContent = Number(sellingPrice).toFixed(2);
  document.getElementById('restock-cost-input').placeholder = 'current: ' + Number(costPrice).toFixed(2);
  document.getElementById('restock-selling-input').placeholder = 'current: ' + Number(sellingPrice).toFixed(2);
  document.getElementById('restock-batch-input').placeholder = 'current: ' + (batchNumber || '—');
  document.getElementById('restockModal').classList.add('open');
}

// EDIT
function openEdit(id, name, genericName, category, form, strength, unit, manufacturer, serialNumber, reorderLevel){
  document.getElementById('editForm').action = '/inventory/' + id + '/edit';
  document.getElementById('edit-name').value = name;
  document.getElementById('edit-genericName').value = genericName;
  document.getElementById('edit-category').value = category;
  document.getElementById('edit-form').value = form;
  document.getElementById('edit-strength').value = strength;
  document.getElementById('edit-unit').value = unit;
  document.getElementById('edit-manufacturer').value = manufacturer;
  document.getElementById('edit-serialNumber').value = serialNumber;
  document.getElementById('edit-reorderLevel').value = reorderLevel;
  document.getElementById('editModal').classList.add('open');
}

// HISTORY
function openHistoryFromBtn(btn){
  const name = btn.dataset.name;
  const history = JSON.parse(btn.dataset.history || '[]');
  openHistory(name, history);
}

function openHistory(name, history){
  document.getElementById('history-name').textContent = name;
  const list = document.getElementById('history-list');
  list.innerHTML = '';

  if (!history || history.length === 0){
    list.innerHTML = '<p style="font-size:13px;color:#94a3b8;">No history recorded yet.</p>';
  } else {
    // most recent first
    [...history].reverse().forEach(h => {
      const date = h.changedAt ? new Date(h.changedAt).toLocaleDateString('en-GB', {day:'numeric', month:'short', year:'numeric'}) : '';
      const item = document.createElement('div');
      item.className = 'history-item';
      item.innerHTML =
        '<div class="history-date">' + escapeHtml(date) + '</div>' +
        '<div><strong>+' + (h.quantityAdded || 0) + '</strong> units added' +
        (h.batchNumber ? ' &middot; Batch ' + escapeHtml(h.batchNumber) : '') + '</div>' +
        '<div>Cost: GHS ' + Number(h.costPrice || 0).toFixed(2) + ' &middot; Selling: GHS ' + Number(h.sellingPrice || 0).toFixed(2) + '</div>' +
        (h.expiryDate ? '<div>Expiry: ' + new Date(h.expiryDate).toLocaleDateString('en-GB') + '</div>' : '') +
        (h.note ? '<div style="margin-top:4px;color:#64748b;">' + escapeHtml(h.note) + '</div>' : '');
      list.appendChild(item);
    });
  }

  document.getElementById('historyModal').classList.add('open');
}

function escapeHtml(str){
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

// Close on backdrop click
['addModal','restockModal','editModal','historyModal'].forEach(id => {
  document.getElementById(id).addEventListener('click', function(e){
    if (e.target === this) closeModal(id);
  });
});
</script>

</body>
</html>
