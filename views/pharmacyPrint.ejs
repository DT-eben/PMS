<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Takeaway Slip - <%= patient.name %></title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; font-family: 'Segoe UI', Arial, sans-serif; }
  body { padding:40px; color:#0f172a; max-width:700px; margin:0 auto; }

  .slip-header {
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    border-bottom:3px solid #1e293b;
    padding-bottom:16px;
    margin-bottom:24px;
  }
  .slip-header h1 { font-size:20px; }
  .slip-header p { font-size:12px; color:#64748b; margin-top:4px; }
  .slip-header .stamp {
    text-align:right;
    font-size:12px;
    color:#64748b;
  }

  .notice {
    background:#fef2f2;
    border:1px solid #fecaca;
    border-left:4px solid #ef4444;
    border-radius:8px;
    padding:14px 16px;
    font-size:13px;
    color:#991b1b;
    margin-bottom:24px;
    line-height:1.6;
  }

  .info-grid {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px 20px;
    margin-bottom:28px;
    font-size:13px;
  }
  .info-grid div span { display:block; color:#94a3b8; font-size:11px; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:2px; }
  .info-grid div strong { font-size:14px; }

  table { width:100%; border-collapse:collapse; margin-bottom:28px; }
  thead th {
    text-align:left;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:0.5px;
    color:#64748b;
    padding:10px 12px;
    border-bottom:2px solid #1e293b;
  }
  tbody td {
    padding:12px;
    font-size:13px;
    border-bottom:1px solid #e2e8f0;
  }

  .empty { text-align:center; padding:30px; color:#94a3b8; font-size:13px; }

  .footer {
    margin-top:40px;
    display:flex;
    justify-content:space-between;
    font-size:12px;
    color:#64748b;
  }
  .footer .sign-line {
    margin-top:36px;
    border-top:1px solid #94a3b8;
    padding-top:6px;
    width:200px;
    text-align:center;
  }

  .print-btn {
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:10px 18px;
    background:#1e293b;
    color:white;
    border:none;
    border-radius:8px;
    font-size:13px;
    cursor:pointer;
    margin-bottom:20px;
  }

  @media print {
    .no-print { display:none; }
    body { padding:20px; }
  }
</style>
</head>
<body>

  <button class="print-btn no-print" onclick="window.print()">🖨 Print this slip</button>

  <div class="slip-header">
    <div>
      <h1>Pharmacy Takeaway Slip</h1>
      <p>Items below were NOT dispensed on-site. Please purchase from an external pharmacy.</p>
    </div>
    <div class="stamp">
      <div>Printed: <%= new Date(printedAt).toLocaleString('en-GB') %></div>
      <div>By: <%= printedBy %></div>
    </div>
  </div>

  <div class="notice">
    <strong>Important:</strong> The drug(s) listed below could not be supplied by our pharmacy
    due to insufficient or zero stock at the time of dispensing. Please take this slip to an
    external pharmacy to purchase the listed item(s) as prescribed.
  </div>

  <div class="info-grid">
    <div><span>Patient</span><strong><%= patient.name %></strong></div>
    <div><span>Patient ID</span><strong><%= patient.patientID %></strong></div>
    <div><span>Prescribing Doctor</span><strong><%= doctor ? doctor.name : '—' %></strong></div>
    <div><span>Visit Date</span><strong><%= new Date(visit.createdAt).toLocaleDateString('en-GB') %></strong></div>
  </div>

  <% if (!missingDrugs || missingDrugs.length === 0) { %>
    <div class="empty">No missing drugs recorded for this visit.</div>
  <% } else { %>
  <table>
    <thead>
      <tr>
        <th>Drug</th>
        <th>Dosage</th>
        <th>Frequency</th>
        <th>Duration</th>
        <th>Route</th>
      </tr>
    </thead>
    <tbody>
      <% missingDrugs.forEach(d => { %>
      <tr>
        <td><strong><%= d.drugName %></strong></td>
        <td><%= d.dosage || '—' %></td>
        <td><%= d.frequency || '—' %></td>
        <td><%= d.duration || '—' %></td>
        <td><%= d.route || '—' %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>

  <div class="footer">
    <div class="sign-line">Pharmacist Signature</div>
    <div class="sign-line">Patient Signature</div>
  </div>

</body>
</html>
